{
  "name": "bengala",
  "version": "0.0.2",
  "description": "Real-time web analytics and user presence tracking engine",
  "main": "app.js",
  "author": {
    "name": "Thomas Abbondi",
    "email": "thomas.abbondi@crystalware.cloud",
    "url": "https://www.crystalware.cloud"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start": "node ./app.js",
    "dev": "nodemon app.js --exec \"pnpm lint && node\"",
    "lint": "eslint --fix app.js static-server.js classes/",
    "lint:check": "eslint app.js static-server.js classes/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm lint:check && pnpm format:check",
    "mongo": "mongod --dbpath ./data/db",
    "prepare": "husky"
  },
  "dependencies": {
    "mongodb": "^7.8.0",
    "uniqid": "^5.4.0",
    "ws": "^8.22.2"
  },
  "files": [
    "app.js",
    "static-server.js",
    "classes/**/*.js",
    "public/**/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  }
}
