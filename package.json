{
  "name": "bengala-monorepo",
  "version": "0.0.2",
  "private": true,
  "description": "Real-time web analytics and user presence tracking engine (monorepo)",
  "author": {
    "name": "Thomas Abbondi",
    "email": "thomas.abbondi@crystalware.cloud",
    "url": "https://www.crystalware.cloud"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm --filter @bengala/shared build && pnpm --filter @bengala/server-ws build && pnpm --filter @bengala/client build",
    "build:shared": "pnpm --filter @bengala/shared build",
    "build:server": "pnpm --filter @bengala/server-ws build",
    "build:client": "pnpm --filter @bengala/client build",
    "dev": "pnpm --filter @bengala/server-ws dev",
    "dev:client": "pnpm --filter @bengala/client dev",
    "dev:ws": "pnpm --filter @bengala/server-ws dev",
    "start": "pnpm --filter @bengala/server-ws start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint --fix packages/",
    "lint:check": "eslint packages/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm typecheck && pnpm lint:check && pnpm format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  }
}
