# Bengala Environment Configuration

# Server Ports & Host
PORT=9080
STATIC_PORT=3000
HOST=localhost

# -------------------------------------------------------------
# Option 1: MongoDB Atlas Connection (Recommended for Cloud)
# -------------------------------------------------------------
# Replace with your actual Atlas SRV connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority

# -------------------------------------------------------------
# Option 2: Local / Dedicated MongoDB Instance
# -------------------------------------------------------------
# MONGO_URI=mongodb://localhost:27017
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_PROTOCOL=mongodb
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_OPTIONS=

# Database name prefix for multi-tenant isolation
MONGO_PREFIX=beng-
